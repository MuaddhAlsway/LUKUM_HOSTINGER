# LAKUM Artspace - Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lakum_artspace

# API Configuration
API_URL=http://localhost/LUKUM/api/
SITE_URL=http://localhost/LUKUM/

# Security
JWT_SECRET=change-this-secret-key-in-production
SESSION_TIMEOUT=3600

# Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf

# CORS Configuration
ALLOWED_ORIGIN=http://localhost

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@lakumartspace.com

# Timezone
TIMEZONE=Asia/Riyadh

# Environment
APP_ENV=development
APP_DEBUG=true

# For InfinityFree Hosting
# DB_HOST=localhost
# DB_USER=your_infinityfree_username
# DB_PASS=your_infinityfree_password
# DB_NAME=your_database_name
# API_URL=https://your-domain.infinityfree.me/LUKUM/api/
# SITE_URL=https://your-domain.infinityfree.me/LUKUM/
# APP_ENV=production
# APP_DEBUG=false
