# LAKUM Artspace - Performance & Security Optimization
# Last Updated: May 1, 2026

# ============================================================================
# 1. ENABLE GZIP COMPRESSION (70% reduction in file size)
# ============================================================================
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, XML, JSON
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Compress fonts
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/truetype
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    
    # Exclude already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz)$ no-gzip dont-vary
</IfModule>

# ============================================================================
# 2. HTTP CACHING HEADERS (Faster repeat visits)
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache images for 1 year (31536000 seconds)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Cache fonts for 1 year
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Cache CSS/JS for 1 month (versioned in code)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Cache HTML for 1 day (dynamic content)
    ExpiresByType text/html "access plus 1 day"
    
    # Default: 1 day
    ExpiresDefault "access plus 1 day"
</IfModule>

# ============================================================================
# 3. CACHE-CONTROL HEADERS (Browser caching)
# ============================================================================
<IfModule mod_headers.c>
    # Cache images for 1 year (immutable)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Cache fonts for 1 year (immutable)
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    # Cache CSS/JS for 1 month (versioned)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # Don't cache HTML (dynamic content)
    <FilesMatch "\.html?$">
        Header set Cache-Control "max-age=86400, public, must-revalidate"
    </FilesMatch>
    
    # Don't cache PHP (dynamic content)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ============================================================================
# 4. SECURITY HEADERS
# ============================================================================
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Feature policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================================================
# 5. ENABLE MOD_REWRITE FOR CLEAN URLS
# ============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # ========================================================================
    # CLEAN URLS - Database-driven titles (NO HARDCODING)
    # ========================================================================
    
    # Clean URL for blog detail pages (MUST come before generic event rule)
    # /blog/my-blog-post?lang=en → blogPageDetails.php?title=my-blog-post&lang=en
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-z0-9-]+)/?$ blogPageDetails.php?title=$1 [QSA,L]
    
    # Clean URL for event detail pages
    # /dior-exhibition?lang=en → event.php?title=dior-exhibition&lang=en
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(event|blog|press|api|assest|fonts|uploads|heroImage|gallery|scripts|includes|lang|translations|data|logs|admin|about)/ [NC]
    RewriteRule ^([a-z0-9-]+)/?$ event.php?title=$1 [QSA,L]
    
    # Clean URL for press detail pages
    # /press-release-1?lang=en → pressPageDetails.php?title=press-release-1&lang=en
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^press/([a-z0-9-]+)/?$ pressPageDetails.php?title=$1 [QSA,L]
    
    # ========================================================================
    # REMOVE .PHP EXTENSION (for other pages)
    # ========================================================================
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
    
    # ========================================================================
    # REDIRECT WWW TO NON-WWW
    # ========================================================================
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
    
    # ========================================================================
    # REDIRECT HTTP TO HTTPS
    # ========================================================================
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================================
# 6. DISABLE DIRECTORY LISTING
# ============================================================================
Options -Indexes

# ============================================================================
# 7. CUSTOM ERROR PAGES
# ============================================================================
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# ============================================================================
# 8. PERFORMANCE: KEEP-ALIVE
# ============================================================================
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# ============================================================================
# 9. MOBILE PERFORMANCE: REDUCE REDIRECTS
# ============================================================================
<IfModule mod_rewrite.c>
    # Avoid redirect chains
    RewriteCond %{HTTP_HOST} ^lakumartspace\.infinityfree\.me$ [NC]
    RewriteRule ^(.*)$ https://lakumartspace.infinityfree.me/$1 [R=301,L]
</IfModule>

# ============================================================================
# 10. PERFORMANCE: MINIMIZE PAYLOAD
# ============================================================================
<IfModule mod_deflate.c>
    # Ensure all text-based content is compressed
    <FilesMatch "\.(php|html|css|js|json|xml)$">
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    </FilesMatch>
</IfModule>

